# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email: Gmail requires 2-Step Verification and an app password
GMAIL_USER=ward-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Optional alternative: Resend requires a verified sending domain
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Tithing Declaration <appointments@example.org>

# App auth
ADMIN_PASSWORD=your-admin-password
SESSION_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=your-cron-secret

# Google Calendar: private server-side OAuth credentials for nightly/manual sync
GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALENDAR_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_CALENDAR_ID=primary
